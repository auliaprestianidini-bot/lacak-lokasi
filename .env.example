# Frontend
VITE_API_URL=http://localhost:5000/api
VITE_MAP_API_KEY=your_map_api_key
VITE_APP_NAME=Phone Investigation & Global Scam Tracker

# Backend
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/phone_investigation
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=phone_investigation

# API Keys
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_LOOKUP_API_KEY=your_twilio_phone_lookup_api_key

OPENCODE_API_KEY=your_opencage_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Features
ENABLE_SCAM_REPORTS=true
ENABLE_PHONE_LOOKUP=true
ENABLE_GEOLOCATION=true
ENABLE_PAYMENT_INVESTIGATION=true

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
